# Optional. Copy this file to ".env" and put your own key after the equals sign.
# With a key, the Ask tab can reword handbook answers with Gemini (needs internet).
# Without it, the app works exactly the same, fully offline.
# Never commit the real .env file. It is listed in .gitignore.
GEMINI_API_KEY=
# Optional: which Gemini model to use.
# GEMINI_MODEL=gemini-3.5-flash-lite
